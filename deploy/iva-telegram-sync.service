[Unit]
Description=Iva incremental sync of five work Telegram chats
After=network-online.target iva.service telegram-userbot.service

[Service]
UMask=0077
Type=oneshot
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -w 900 __PROJECT_DIR__/.telegram-sync.lock __NODE__ --env-file=.env scripts/memory/telegram-sync.ts
