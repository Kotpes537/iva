[Unit]
Description=Iva incremental sync of five work Telegram chats
After=network-online.target iva.service telegram-userbot.service

[Service]
UMask=0077
Type=oneshot
WorkingDirectory=/root/iva
EnvironmentFile=/root/iva/.env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/flock -w 900 /root/iva/.telegram-sync.lock /root/.nvm/versions/node/v24.18.0/bin/node --env-file=.env scripts/memory/telegram-sync.ts
